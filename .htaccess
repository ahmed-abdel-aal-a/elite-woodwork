# ==============================================================================
# ELITE ARCHITECTURAL WOOD ENGINEERING - PRODUCTION SERVER CONFIGURATION
# Subfolder Deployment Path: /elite/
# Domain: apex-agency.tech/elite/
# ==============================================================================

# 1. Default Encoding
AddDefaultCharset UTF-8

# 2. Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /elite/

    # Ensure trailing slash on folder root
    RewriteCond %{REQUEST_URI} ^/elite$
    RewriteRule ^(.*)$ /elite/ [R=301,L]

    # Clean HTML Routing: If requested without .html and .html exists, rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # Custom 404 Error Document
    ErrorDocument 404 /elite/404.html
</IfModule>

# 3. High-Performance Caching for Immutable Next.js Assets & Images
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Static Next.js Chunks (Immutable cache)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Images & Media
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # HTML Pages (Always revalidate for instant updates)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 4. Gzip & Brotli Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
